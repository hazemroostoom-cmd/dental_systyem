rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isDentist() {
      return isAuthenticated() &&
             firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'dentist';
    }

    function isTechnician() {
      return isAuthenticated() &&
             firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'technician';
    }

    function isLabManager() {
      return isAuthenticated() &&
             firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'lab_manager';
    }

    function canAccessCase(caseId) {
      return isAdmin() ||
             (isDentist() && firestore.get(/databases/(default)/documents/cases/$(caseId)).data.dentistId == request.auth.uid) ||
             (isTechnician() && firestore.get(/databases/(default)/documents/cases/$(caseId)).data.technicianId == request.auth.uid) ||
             (isLabManager() && firestore.get(/databases/(default)/documents/cases/$(caseId)).data.labManagerId == request.auth.uid);
    }

    // Case files - organized by case ID
    match /cases/{caseId}/{allPaths=**} {
      // Users with case access can read files
      allow read: if canAccessCase(caseId);

      // Users with case access can upload files
      allow create: if canAccessCase(caseId) &&
                       // Validate file types and sizes
                       request.resource.size < 50 * 1024 * 1024 && // 50MB max
                       request.resource.contentType.matches('image/.*|application/pdf|model/.*|application/stl|application/obj');

      // Users with case access can update/delete their own uploads
      allow update, delete: if canAccessCase(caseId) &&
                               resource.metadata.uploaderId == request.auth.uid;
    }

    // User profile images
    match /users/{userId}/profile/{fileName} {
      // Users can read their own profile images
      allow read: if isAuthenticated();

      // Users can upload/update their own profile images
      allow create, update: if isAuthenticated() &&
                               request.auth.uid == userId &&
                               request.resource.size < 5 * 1024 * 1024 && // 5MB max
                               request.resource.contentType.matches('image/.*');

      // Users can delete their own profile images
      allow delete: if isAuthenticated() &&
                       request.auth.uid == userId;
    }

    // Temporary uploads (for processing)
    match /temp/{userId}/{fileName} {
      // Users can manage their own temp files
      allow read, write: if isAuthenticated() &&
                            request.auth.uid == userId &&
                            request.resource.size < 100 * 1024 * 1024; // 100MB max for temp

      // Temp files auto-delete after 24 hours (handled by Firebase Functions)
    }

    // Public assets (logos, templates, etc.)
    match /public/{allPaths=**} {
      // Only admins can manage public assets
      allow read: if true; // Public read access
      allow write: if isAdmin();
    }
  }
}